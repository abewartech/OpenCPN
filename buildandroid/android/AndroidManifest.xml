<?xml version="1.0"?>
<!--
  OpenCPN Android manifest — modernized.

  * minSdk 24 (Android 7.0): floor for runtime permissions + GnssStatus APIs.
    Older devices are no longer viable targets for the Qt5/wxQt stack.
  * targetSdk 35 (Android 15): required for Play + modern behavior
    (edge-to-edge, foreground-service types, photo picker, etc.).
  * GPS tracking runs in a real foreground service (org.opencpn.GPSServer)
    declared below with foregroundServiceType="location".
  * WRITE_EXTERNAL_STORAGE is capped at API 28 (scoped storage takes over);
    chart folders are chosen via Storage Access Framework (ACTION_OPEN_DOCUMENT_TREE).
  * The Google Maps API key is intentionally a placeholder: never commit a real
    key. Inject it at build time if the optional Google Maps overlay is used.
-->
<manifest package="org.opencpn.opencpn"
          xmlns:android="http://schemas.android.com/apk/res/android"
          android:versionName="1.0"
          android:versionCode="1"
          android:installLocation="auto">

    <application
        android:hardwareAccelerated="true"
        android:name="org.qtproject.qt5.android.bindings.QtApplication"
        android:label="@string/app_name"
        android:icon="@drawable/opencpn_mobile"
        android:theme="@style/Theme.OCPN"
        android:allowBackup="true"
        android:supportsRtl="true">

        <activity
            android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|density|locale|fontScale|keyboard|keyboardHidden|navigation"
            android:name="org.qtproject.qt5.android.bindings.QtActivity"
            android:label="@string/app_name"
            android:screenOrientation="unspecified"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="android.app.lib_name" android:value="opencpn"/>
            <meta-data android:name="android.app.qt_sources_resource_id" android:resource="@array/qt_sources"/>
            <meta-data android:name="android.app.repository" android:value="default"/>
            <meta-data android:name="android.app.qt_libs_resource_id" android:resource="@array/qt_libs"/>
            <meta-data android:name="android.app.bundled_libs_resource_id" android:resource="@array/bundled_libs"/>
            <!-- Deploy Qt libs as part of package -->
            <meta-data android:name="android.app.bundle_local_qt_libs" android:value="-- %%BUNDLE_LOCAL_QT_LIBS%% --"/>
            <!-- bundled_in_lib/bundled_in_assets resources are generated by
                 androiddeployqt; referencing them here causes AAPT errors when
                 the generation is skipped. -->
            <!-- Run with local libs -->
            <meta-data android:name="android.app.use_local_qt_libs" android:value="-- %%USE_LOCAL_QT_LIBS%% --"/>
            <meta-data android:name="android.app.libs_prefix" android:value="/data/local/tmp/qt/"/>
            <meta-data android:name="android.app.load_local_libs" android:value="-- %%INSERT_LOCAL_LIBS%% --"/>
            <meta-data android:name="android.app.load_local_jars" android:value="-- %%INSERT_LOCAL_JARS%% --"/>
            <meta-data android:name="android.app.static_init_classes" android:value="-- %%INSERT_INIT_CLASSES%% --"/>
            <!-- Splash screen -->
            <meta-data android:name="android.app.splash_screen" android:resource="@layout/splash"/>
            <!-- Splash screen -->
        </activity>

        <!--
          Real foreground service for GPS/NMEA tracking. Survives the Activity
          being backgrounded (screen off, app switched away) on Android 8+.
          Stopped explicitly by the user or when the native layer disables GPS.
        -->
        <service
            android:name="org.opencpn.GPSServer"
            android:exported="false"
            android:foregroundServiceType="location"
            android:description="@string/gps_service_description" />

        <activity android:name="org.opencpn.OCPNSettingsActivity"
                  android:exported="false">
            <meta-data android:name="android.app.lib_name" android:value="opencpn"/>
        </activity>
        <activity android:name="org.opencpn.FileChooser"
                  android:exported="false">
            <meta-data android:name="android.app.lib_name" android:value="opencpn"/>
        </activity>

        <activity android:name="ar.com.daidalos.afiledialog.FileChooserActivity"
                  android:exported="false">
            <meta-data android:name="android.app.lib_name" android:value="opencpn"/>
        </activity>

        <activity android:name="org.opencpn.OCPNMapsActivity"
                  android:exported="false">
            <meta-data android:name="android.app.lib_name" android:value="opencpn"/>
        </activity>

        <activity android:name="org.opencpn.WebViewActivity"
                  android:theme="@style/Theme.OCPN.NoTitleBar"
                  android:exported="false">
            <meta-data android:name="android.app.lib_name" android:value="opencpn"/>
        </activity>

        <!-- Optional Google Maps overlay. Inject a real key at build time; the
             placeholder below keeps the manifest valid without leaking secrets. -->
        <meta-data android:name="com.google.android.geo.API_KEY"
                   android:value="__GOOGLE_MAPS_API_KEY__"/>

        <!-- Google Play Services version meta-data removed: the
             @integer/google_play_services_version resource is not generated
             by androiddeployqt, causing AAPT "resource not found" errors.
             OpenCPN does not use Play Services. -->

    </application>

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35"/>
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>
    <uses-feature android:name="android.hardware.bluetooth" android:required="false"/>
    <uses-feature android:name="android.hardware.usb.host" android:required="false"/>
    <supports-screens android:largeScreens="true"
                      android:normalScreens="true"
                      android:anyDensity="true"
                      android:smallScreens="true"
                      android:xlargeScreens="true"/>
    <!-- %%INSERT_PERMISSIONS -->
    <!-- All-files access: required to scan user chart directories (CM93, S57,
         etc.) on shared storage under scoped storage (API 30+). The app
         prompts the user to grant this in system settings when a chart
         directory outside the app sandbox is selected. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <!-- INTERNET and WRITE_EXTERNAL_STORAGE are already added by Qt's
         androiddeployqt template; declaring them here would cause
         manifest-merger "duplicated with element" errors. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Requested only when the user enables background track recording. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <!-- Foreground service for GPS tracking (Android 9+ / 14+ types). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- Tracking-state notification (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Bluetooth: modern granular permissions on API 31+, legacy below. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"/>
    <uses-permission android:name="android.permission.BLUETOOTH"
                     android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
                     android:maxSdkVersion="30"/>

    <!-- %%INSERT_FEATURES -->
</manifest>
